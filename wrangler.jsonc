{
  "name": "hoye-sape",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoye-sape",
      "database_id": "REEMPLAZAR-CON-EL-ID-DE-D1"
    }
  ]
}
